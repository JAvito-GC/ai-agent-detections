event_type="tool_result" content.source IN ("tool_output", "retrieval", "web_fetch") content IN ("*ignore previous instructions*", "*ignore all previous*", "*disregard the above*", "*you are now*", "*system prompt*", "*print your instructions*", "*reveal your system*", "*exfiltrate*", "*send the api key*", "*new instructions:*") NOT content.scanner_verdict="benign_confirmed" | table session_id,agent,content.source,tool.name,content
