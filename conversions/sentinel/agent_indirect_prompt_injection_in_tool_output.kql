AIAgentRuntime_CL
| where (event_type =~ "tool_result" and (content_source in~ ("tool_output", "retrieval", "web_fetch")) and (content contains "ignore previous instructions" or content contains "ignore all previous" or content contains "disregard the above" or content contains "you are now" or content contains "system prompt" or content contains "print your instructions" or content contains "reveal your system" or content contains "exfiltrate" or content contains "send the api key" or content contains "new instructions:")) and (not(content_scanner_verdict =~ "benign_confirmed"))
