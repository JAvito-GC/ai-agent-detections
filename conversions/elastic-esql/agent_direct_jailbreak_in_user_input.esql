from * metadata _id, _index, _version | where event_type=="user_prompt" and content.source=="user" and (TO_LOWER(content) like "*ignore previous instructions*" or TO_LOWER(content) like "*developer mode*" or TO_LOWER(content) like "*pretend you have no restrictions*" or TO_LOWER(content) like "*bypass your guidelines*") or event_type=="user_prompt" and content.source=="user" and content rlike ".*\\bDAN\\b.*"
