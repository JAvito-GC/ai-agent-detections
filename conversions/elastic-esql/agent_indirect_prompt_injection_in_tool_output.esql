from * metadata _id, _index, _version | where event_type=="tool_result" and (content.source in ("tool_output", "retrieval", "web_fetch")) and (TO_LOWER(content) like "*ignore previous instructions*" or TO_LOWER(content) like "*ignore all previous*" or TO_LOWER(content) like "*disregard the above*" or TO_LOWER(content) like "*you are now*" or TO_LOWER(content) like "*system prompt*" or TO_LOWER(content) like "*print your instructions*" or TO_LOWER(content) like "*reveal your system*" or TO_LOWER(content) like "*exfiltrate*" or TO_LOWER(content) like "*send the api key*" or TO_LOWER(content) like "*new instructions:*") and not COALESCE(content.scanner_verdict=="benign_confirmed", false)
